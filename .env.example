# ============================================
# API GLPI - Central Minerva Foods
# ============================================
# Credenciais para acesso à API do GLPI
# Endpoint: https://central.minervafoods.com/apirest.php
#
# IMPORTANTE: Não commite este arquivo com valores reais!
# Copie para .env e preencha com suas credenciais.
# ============================================

# Token de autenticação Basic (base64)
# Formato: base64(usuario:senha)
# Gere em: https://www.base64encode.org/
VITE_GLPI_AUTH_BASIC=seu_token_basic_base64_aqui

# App Token gerado no GLPI
# Obtenha em: GLPI > Configurar > Geral > API
VITE_GLPI_APP_TOKEN=seu_app_token_aqui

# ID da entidade GLPI (campo 80 — unidade organizacional).
# DEIXE VAZIO se você só conhece o ID do GRUPO técnico (campo 8) —
# colocar aqui o mesmo ID do grupo faz o GLPI buscar tickets em uma
# entidade que não existe e retornar 0 chamados sem erro nenhum.
# Só preencha se a TI tiver te confirmado um ID de entidade real.
VITE_GLPI_ENTITY_ID=

# ID do grupo técnico GLPI (campo 8 — fila/grupo de atendentes).
# Restringe a busca à fila desse grupo. Default: 108 (RPA Minerva).
VITE_GLPI_GROUP_ID=108

# ============================================
# Configuração da equipe RPA
# ============================================

# Colaboradores que terão apontamentos contabilizados.
# Sintaxe: nome canônico|nome canônico|...
# Aliases (formas variantes do mesmo nome) com vírgula:
#   Nome Canonico,Alias 1,Alias 2|Outro Nome
VITE_RPA_COLLABORATORS=Nome Sobrenome|Outro Nome,Variante Do Nome

# Quantos dias um chamado em aberto precisa ficar parado para entrar no KPI
# "Chamados Parados" e receber o badge "Parado há Xd" na tabela.
# Padrão: 7 dias.
VITE_STALE_DAYS=7

# Lista de grupos técnicos disponíveis no seletor multi-grupo
# Sintaxe: id:nome|id:nome (o primeiro é o padrão)
VITE_GLPI_GROUPS=108:RPA
