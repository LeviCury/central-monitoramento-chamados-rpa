# ============================================
# API GLPI - Central Minerva Foods
# ============================================
# Credenciais para acesso à API do GLPI
# Endpoint: https://central.minervafoods.com/apirest.php
#
# IMPORTANTE: Não commite este arquivo com valores reais!
# Copie para .env e preencha com suas credenciais.
# ============================================

# Token de autenticação Basic (base64)
# Formato: base64(usuario:senha)
# Gere em: https://www.base64encode.org/
VITE_GLPI_AUTH_BASIC=seu_token_basic_base64_aqui

# App Token gerado no GLPI
# Obtenha em: GLPI > Configurar > Geral > API
VITE_GLPI_APP_TOKEN=seu_app_token_aqui

# ID do grupo técnico
# Exemplo: 108 = RPA
VITE_GLPI_ENTITY_ID=seu_id_aqui
